{
  "env": {
    "es2021": true,
    "browser": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-console": "off"
  }
}
